{
  "name": "mmdv",
  "version": "1.0.0",
  "description": "Minimal Obsidian-style live-preview markdown editor",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --target=chrome140 --outfile=dist/renderer.js",
    "start": "npm run build && electron44 ."
  },
  "type": "commonjs",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true,
  "desktopName": "mmdv.desktop"
}
